# Kunci opsional dezz-osint — salin ke .env, isi yang perlu saja.
# Semua perintah inti jalan TANPA kunci apa pun. Jangan commit .env.
# Lihat dezz/engines/config.py untuk pemakaian tiap kunci.

# Google Custom Search — dipakai `dezz phone` (pencarian web nomor).
# Tanpa ini, phone mencetak SKIP yang jujur untuk bagian pencarian.
GOOGLE_API_KEY=
GOOGLE_CX=

# NumVerify — verifikasi nomor (opsional, belum di-wire penuh).
NUMVERIFY_API_KEY=

# IPStack — sumber geo IP alternatif (ip-api adalah sumber utama, tanpa kunci).
IPSTACK_API_KEY=

# RapidAPI WhatsApp — cek WhatsApp (opsional).
RAPIDAPI_WHATSAPP_KEY=

# GitHub personal access token (opsional) — menaikkan limit api.github.com
# dari 60 req/jam (tanpa kunci) ke 5000 req/jam. Tanpa ini semua tetap jalan.
GITHUB_TOKEN=

# Checkout upstream (opsional) — default: folder di sebelah repo.
# MAIGRET_DIR=
# TOOKIE_DIR=
# PHOTON_DIR=
# SPIDERFOOT_DIR=
# AWESOME_README=

# Tuning (opsional).
# NETRA_TIMEOUT=12
# NETRA_WORKERS=10
